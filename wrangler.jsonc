{
	"$schema": "https://unpkg.com/wrangler@4.162.0/config-schema.json",
	"name": "luizalves-dev",
	"compatibility_date": "2026-11-10",
	// Static site only: Cloudflare serves the Astro build straight from dist.
	"assets": {
		"directory": "./dist",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "none"
	},
	"routes": [
		{ "pattern": "luizalves.dev", "custom_domain": true },
		{ "pattern": "www.luizalves.dev", "custom_domain": true }
	]
}
