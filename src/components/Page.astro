---
import type { Locale } from '../i18n/content'
import { content, mailto, EMAIL, LINKEDIN, GITHUB } from '../i18n/content'
import Header from './Header.astro'
import Project from './Project.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = content[locale]
const mail = mailto(locale)
const words = (s: string) => s.split(' ')
const pad = (n: number) => String(n + 1).padStart(2, '0')
const decimal = locale === 'pt' ? ',' : '.'
const fmtNum = (n: number, f: string) => (f === 'tilde' ? '~1M' : f === 'dec' ? n.toFixed(1).replace('.', decimal) : String(n))
const arrowUpRight = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9"></path></svg>'
const arrowRight = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>'
const side = t.work.side
---

<a class="skip" href="#conteudo">{t.ui.skip}</a>
<Header locale={locale} />

<main id="conteudo">
  <!-- Hero -->
  <section id="topo" class="hero dots">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="hero-fade" aria-hidden="true"></div>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <div class="hero-titles">
          <p class="hello">
            <img src="/me.webp" alt={t.hero.photoAlt} width="40" height="40" class="avatar" data-reveal data-hero="hello-img" />
            <span class="mask"><span data-hero="hello">{t.hero.hello}</span></span>
          </p>
          <h1 class="h1">
            <span class="h1-line">{words(t.hero.title[0]).map((w, i) => <>{i > 0 && ' '}<span class="mask"><span data-hero="word">{w}</span></span></>)}</span>{' '}
            <span class="h1-line accent">{words(t.hero.title[1]).map((w, i) => <>{i > 0 && ' '}<span class="mask"><span data-hero="word">{w}</span></span></>)}</span>
          </h1>
        </div>
        <p class="hero-sub" data-reveal data-hero="sub">{t.hero.subtitle}<span>{t.hero.subtitleStrong}</span>.</p>
        <div class="ctas">
          <a href={mail} class="btn btn-primary" data-reveal data-hero="cta">
            {t.hero.cta1}
            <Fragment set:html={arrowRight} />
          </a>
          <a href="#work" class="btn btn-ghost" data-reveal data-hero="cta">{t.hero.cta2}</a>
        </div>
      </div>
      <div class="proof mono" data-reveal data-hero="panel" data-impact>
        <div class="proof-top">
          <div class="win"><span></span><span></span><span></span></div>
          <b>{t.proof.title}</b>
        </div>
        <div class="proof-grid">
          {t.proof.items.map((p) => (
            <div class="proof-cell">
              <span class="num nowrap">{p.prefix}<span data-num={p.num} data-format={p.format} data-decimal={decimal}>{fmtNum(p.num, p.format)}</span>{p.suffix && <small>{p.suffix}</small>}</span>
              <span class="desc">{p.desc}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Marquee -->
  <div class="marquee" aria-label={t.marqueeLabel} data-marquee>
    <div class="marquee-track mono" data-marquee-track>
      {[0, 1].map((copy) => (
        <div class="marquee-group" aria-hidden={copy === 1 ? 'true' : undefined}>
          {t.marquee.map((item) => (
            <>
              <span>{item}</span>
              <span class="sep">·</span>
            </>
          ))}
        </div>
      ))}
    </div>
  </div>

  <!-- Services -->
  <section id="services" class="section">
    <div class="wrap stack-48">
      <div class="head" data-section-head>
        <span class="eyebrow" data-reveal data-head="label">{t.services.label}</span>
        <h2 class="h2" data-reveal data-head="title">{t.services.title}</h2>
        <p class="lead narrow" data-reveal data-head="title">{t.services.subtitle}</p>
      </div>
      <div class="services" data-group>
        {t.services.list.map((s, i) => (
          <article class={`service ${i === 0 ? 'featured' : ''}`} data-reveal>
            <div class="service-top mono">
              <span class="n">{pad(i)}</span>
              {s.tag && <span class="tag">{s.tag}</span>}
            </div>
            <h3>{s.name}</h3>
            <p>{s.text}</p>
            <p class="service-proof mono"><span class="arrow">→</span>{s.proof}</p>
            <a href={`${mail}${encodeURIComponent(` · ${s.name}`)}`} class="link">{t.services.cta} <Fragment set:html={arrowRight} /></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Work -->
  <section id="work" class="section work">
    <div class="wrap stack-48">
      <div class="head" data-section-head>
        <span class="eyebrow" data-reveal data-head="label">{t.work.label}</span>
        <h2 class="h2" data-reveal data-head="title">{t.work.title}</h2>
        <p class="lead narrow" data-reveal data-head="title">{t.work.subtitle}</p>
      </div>
      <Project p={t.work.featured} />

      <ol class="cases">
        {t.work.cases.map((c, i) => (
          <li class="case" data-group>
            <div class="case-side" data-reveal>
              <span class="case-n mono">{pad(i)}</span>
              <span class="case-co mono">{c.company}</span>
            </div>
            <div class="case-body">
              <h3 data-reveal>{c.title}</h3>
              <p data-reveal>{c.text}</p>
              <p class="case-result" data-reveal><span class="mono">{t.work.result}</span>{c.result}</p>
              <ul class="chips" data-reveal>
                {c.tags.map((tag) => <li class="chip">{tag}</li>)}
              </ul>
            </div>
          </li>
        ))}
      </ol>

      <Project p={side} />
    </div>
  </section>

  <!-- Process -->
  <section id="process" class="section process">
    <div class="wrap stack-48">
      <div class="head" data-section-head>
        <span class="eyebrow" data-reveal data-head="label">{t.process.label}</span>
        <h2 class="h2" data-reveal data-head="title">{t.process.title}</h2>
      </div>
      <ol class="steps" data-group>
        {t.process.steps.map((s, i) => (
          <li class="step" data-reveal>
            <span class="step-n mono">{pad(i)}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Experience -->
  <section id="experience" class="section">
    <div class="wrap exp">
      <div class="exp-head" data-section-head>
        <span class="eyebrow" data-reveal data-head="label">{t.experience.label}</span>
        <h2 class="h2" data-reveal data-head="title">{t.experience.title}</h2>
        <div class="exp-stack" data-reveal data-head="title">
          <span class="mono">{t.experience.stackLabel}</span>
          <ul class="chips">
            {t.experience.stack.map((s) => <li class="chip">{s}</li>)}
          </ul>
        </div>
      </div>
      <ol class="timeline" data-timeline>
        <li class="track" aria-hidden="true"></li>
        <li class="fill" aria-hidden="true" data-timeline-fill></li>
        {t.experience.jobs.map((j) => (
          <li class="job" data-reveal data-job>
            <span class="marker" aria-hidden="true" data-marker></span>
            <div class="job-top" data-reveal data-job-part>
              <h3>{j.role} <span>· {j.company}</span></h3>
              <span class="period mono">{j.period}</span>
            </div>
            <p data-reveal data-job-part>{j.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="contact dots" data-contact>
    <div class="contact-glow" aria-hidden="true"></div>
    <div class="wrap contact-inner">
      <div class="contact-head">
        <span class="eyebrow" data-reveal data-contact-head>{t.contact.label}</span>
        <h2 class="contact-title">{words(t.contact.title).map((w, i) => <>{i > 0 && ' '}<span class="mask"><span data-contact-word>{w}</span></span></>)}</h2>
        <p class="lead contact-text" data-reveal data-contact-text>{t.contact.text}</p>
      </div>
      <div class="contact-grid">
        <a href={mail} class="contact-card primary" data-reveal data-contact-link>
          <span class="cc"><span class="cc-k">{t.contact.email}</span><span class="cc-v mono">{EMAIL}</span></span>
          <svg class="cc-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </a>
        <a href={LINKEDIN} class="contact-card" target="_blank" rel="noopener" data-reveal data-contact-link>
          <span class="cc"><span class="cc-k">LinkedIn</span><span class="cc-v mono">/in/luizalvesdev</span></span>
          <svg class="cc-arrow diag" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9"></path></svg>
        </a>
        <a href={GITHUB} class="contact-card" target="_blank" rel="noopener" data-reveal data-contact-link>
          <span class="cc"><span class="cc-k">GitHub</span><span class="cc-v mono">luizalvesdev</span></span>
          <svg class="cc-arrow diag" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9"></path></svg>
        </a>
      </div>
    </div>
  </section>
</main>

<footer class="footer">
  <div class="wrap footer-inner mono">
    <span>© 2026 Luiz Alves</span>
    <span>{t.footer.built}</span>
  </div>
</footer>

<script>
  import '../scripts/motion'
</script>

<style>
  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(64px, 8vw, 104px) 0 clamp(72px, 8vw, 112px);
  }
  .hero-glow {
    position: absolute;
    top: -160px;
    right: -120px;
    width: 760px;
    height: 620px;
    background: radial-gradient(closest-side, var(--glow), rgba(109, 93, 252, 0));
    pointer-events: none;
  }
  .hero-fade {
    position: absolute;
    inset: 0;
    background: linear-gradient(transparent 60%, var(--bg) 100%);
    pointer-events: none;
  }
  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr));
    gap: clamp(48px, 6vw, 80px);
    align-items: center;
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
  }
  .hero-titles {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .hello {
    margin: 0;
    font-size: 20px;
    color: var(--muted);
  }
  .h1 {
    margin: 0;
    font-size: clamp(44px, 6.2vw, 80px);
    line-height: 1;
    font-weight: 700;
    letter-spacing: -0.035em;
    color: var(--strong);
  }
  .h1-line {
    display: block;
  }
  .h1-line.accent {
    color: var(--accent-2);
  }
  .hero-sub {
    margin: 0;
    max-width: 540px;
    font-size: 18px;
    line-height: 1.6;
    color: var(--muted);
  }
  .hero-sub span {
    color: var(--text);
  }
  .ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .btn {
    height: 48px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 0 22px;
    border-radius: 12px;
    font-size: 15px;
    text-decoration: none;
    transition:
      transform 200ms,
      background-color 200ms,
      box-shadow 200ms,
      border-color 200ms;
  }
  .btn-primary {
    background: var(--accent);
    color: #fff;
    font-weight: 600;
  }
  .btn-primary:hover {
    background: #7b6cff;
    box-shadow: 0 10px 30px -10px rgba(109, 93, 252, 0.8);
    transform: translateY(-1px);
  }
  .btn-ghost {
    border: 1px solid var(--border-3);
    color: var(--text);
    font-weight: 500;
  }
  .btn-ghost:hover {
    border-color: var(--accent-2);
    transform: translateY(-1px);
  }
  /* Marquee */
  .marquee {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--band);
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .marquee-track {
    display: flex;
    width: max-content;
    padding: 22px 0;
    white-space: nowrap;
    font-size: 15px;
    color: var(--muted);
  }
  .marquee-group {
    display: flex;
    gap: 28px;
    padding-right: 28px;
  }
  .sep {
    color: var(--accent);
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      overflow-x: auto;
    }
    .marquee-group[aria-hidden] {
      display: none;
    }
  }

  /* Impact */
  .stack-48 {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  .impact-title {
    margin: 0;
    max-width: 720px;
    font-size: clamp(32px, 4vw, 48px);
    line-height: 1.08;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--strong);
  }
  .impact-title span {
    color: var(--accent-2);
  }
  .impact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr));
    gap: 16px;
  }
  .impact-card {
    padding: 24px 22px 26px;
    border-radius: 16px;
    border: 1px solid var(--border);
    background: var(--surface);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 12px 16px;
  }
  .num {
    flex: 0 0 auto;
    font-size: clamp(36px, 10vw, 46px);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--strong);
    font-variant-numeric: tabular-nums;
  }
  .num b {
    font-weight: 500;
    color: var(--accent-2);
  }
  .num .was {
    color: var(--faint);
  }
  .num small {
    font-size: 20px;
    letter-spacing: 0;
    color: var(--muted);
  }
  .num em {
    font-style: normal;
    font-size: 28px;
  }
  .nowrap {
    white-space: nowrap;
  }
  .desc {
    flex: 1 1 140px;
    font-size: 14.5px;
    line-height: 1.45;
    color: var(--muted);
  }

  /* Projects */
  .projects {
    padding-bottom: clamp(96px, 9vw, 128px);
  }
  .projects-inner {
    display: flex;
    flex-direction: column;
    gap: clamp(40px, 5vw, 64px);
  }
  .head {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .arrow {
    color: var(--accent);
    font-size: 13px;
    padding-top: 2px;
  }
  .links {
    display: flex;
    gap: 20px;
    font-size: 14.5px;
    font-weight: 500;
  }
  .link {
    position: relative;
    display: flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    color: var(--text);
    text-decoration: none;
  }
  .link::before,
  .link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 8px;
    height: 1px;
    background: rgba(169, 163, 255, 0.25);
  }
  .link::after {
    background: var(--accent-2);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 250ms ease;
  }
  .link:hover::after {
    transform: scaleX(1);
  }
  .link :global(svg) {
    transition: transform 250ms ease;
  }
  .link:hover :global(svg) {
    transform: translate(2px, -2px);
  }
  /* Experience */
  .exp {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(40px, 6vw, 96px);
    align-items: flex-start;
  }
  .exp-head {
    flex: 1 1 260px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .timeline {
    flex: 999 1 560px;
    min-width: 0;
    margin: 0;
    padding: 0 0 0 44px;
    list-style: none;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  .track,
  .fill {
    position: absolute;
    left: 7px;
    top: 10px;
    bottom: 10px;
    width: 2px;
    border-radius: 2px;
  }
  .track {
    background: var(--border);
  }
  .fill {
    background: linear-gradient(var(--accent-2), var(--accent));
    box-shadow: rgba(109, 93, 252, 0.6) 0 0 12px;
    transform-origin: top;
  }
  :global(html.motion) .fill {
    transform: scaleY(0);
  }
  .job {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .marker {
    position: absolute;
    left: -44px;
    top: 5px;
    width: 16px;
    height: 16px;
    border-radius: 999px;
    background: var(--accent);
    border: 3px solid var(--bg);
    box-shadow: var(--accent-2) 0 0 0 1px;
    transition:
      background-color 300ms,
      box-shadow 300ms,
      scale 300ms;
  }
  :global(html.motion) .marker:not(.on) {
    background: var(--marker-off);
    box-shadow: var(--border-2) 0 0 0 1px;
    scale: 0.6;
  }
  :global(html.motion) .marker.on {
    box-shadow:
      var(--accent-2) 0 0 0 1px,
      0 0 14px rgba(109, 93, 252, 0.7);
  }
  .job-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px 24px;
  }
  .job h3 {
    margin: 0;
    font-size: 22px;
    font-weight: 650;
    letter-spacing: -0.015em;
    color: var(--strong);
  }
  .job h3 span {
    color: var(--accent-2);
  }
  .period {
    font-size: 13px;
    color: var(--dim);
  }
  .job p {
    margin: 0;
    font-size: 16px;
    line-height: 1.65;
    color: var(--muted);
  }

  /* Stack */
  .stack-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 16px;
  }
  .stack-card {
    padding: 26px 24px 28px;
    border-radius: 18px;
    border: 1px solid var(--border);
    background: var(--surface);
    display: flex;
    flex-direction: column;
    gap: 18px;
    transition: border-color 200ms;
  }
  .stack-card-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }
  .stack-card-head span {
    font-size: 12px;
    color: var(--dim);
    transition: color 200ms;
  }
  .stack-card h3 {
    margin: 0;
    font-size: 19px;
    font-weight: 650;
    letter-spacing: -0.01em;
    color: var(--strong);
  }
  .stack-card ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 12.5px;
  }
  .stack-card li {
    padding: 6px 11px;
    border-radius: 8px;
    border: 1px solid rgba(169, 163, 255, 0.14);
    color: var(--body2);
    transition: background-color 200ms;
  }
  .stack-card:hover {
    border-color: var(--border-3);
  }
  .stack-card:hover .stack-card-head span {
    color: var(--accent-2);
  }
  .stack-card:hover li {
    background: var(--chip-bg);
  }

  /* About */
  .about {
    padding: clamp(72px, 7vw, 96px) 0 clamp(56px, 5vw, 72px);
  }
  .about-inner {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(32px, 5vw, 72px);
    align-items: flex-start;
  }
  .about-side {
    flex: 0 1 320px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .photo {
    width: 100%;
    max-width: 320px;
    aspect-ratio: 1;
    border-radius: 24px;
    border: 1px solid rgba(169, 163, 255, 0.18);
    background: radial-gradient(circle at 50% 30%, var(--photo-from), var(--surface) 70%);
    overflow: hidden;
  }
  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  :global(html.motion) .photo {
    clip-path: inset(100% 0 0 0);
  }
  .about-copy {
    flex: 999 1 480px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding-top: 36px;
  }
  .about-text {
    margin: 0;
    max-width: 680px;
    font-size: 18px;
    line-height: 1.7;
    color: var(--about);
  }
  .about-edu {
    margin: 0;
    font-size: 13px;
    line-height: 1.7;
    color: var(--dim);
  }

  /* Contact */
  .contact {
    position: relative;
    overflow: hidden;
    padding: clamp(72px, 7vw, 96px) 0;
    border-top: 1px solid rgba(169, 163, 255, 0.08);
  }
  .contact-glow {
    position: absolute;
    left: 50%;
    top: -220px;
    width: 900px;
    height: 600px;
    transform: translateX(-50%);
    background: radial-gradient(closest-side, var(--glow), rgba(109, 93, 252, 0));
    pointer-events: none;
  }
  .contact-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .contact-head {
    display: flex;
    flex-direction: column;
    gap: 18px;
