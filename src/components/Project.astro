---
interface Props {
  p: {
    kind: string
    name: string
    description: string
    decisions: string[]
    stack: string[]
    links: { label: string; href: string }[]
    url: string
    image: string
    alt: string
    result?: string
    resultLabel?: string
    width?: number
    height?: number
    phones?: { src: string; alt: string }[]
  }
}

const { p } = Astro.props
const arrowUpRight = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9"></path></svg>'
---

<article class="project" data-reveal data-project>
  <div class="project-glow" aria-hidden="true"></div>
  <div class="project-copy">
    <div class="kind mono" data-reveal data-item><span>{p.kind}</span></div>
    <h3 data-reveal data-item>{p.name}</h3>
    <p class="project-desc" data-reveal data-item>{p.description}</p>
    {p.result && <p class="result" data-reveal data-item><span class="mono">{p.resultLabel}</span>{p.result}</p>}
    <div class="decisions">
      <ul>
        {p.decisions.map((d) => (
          <li data-reveal data-item><span class="arrow">→</span><span>{d}</span></li>
        ))}
      </ul>
    </div>
    <ul class="chips">
      {p.stack.map((s) => <li class="chip" data-reveal data-tag>{s}</li>)}
    </ul>
    {p.links.length > 0 && (
      <div class="links">
        {p.links.map((l) => (
          <a href={l.href} class="link" target="_blank" rel="noopener" data-reveal data-item>{l.label} <Fragment set:html={arrowUpRight} /></a>
        ))}
      </div>
    )}
  </div>
  {p.phones ? (
    <div class="media phones dots" data-reveal data-media>
      {p.phones.map((img, i) => (
        <div class={`phone ${i === 1 ? 'mid' : ''}`} data-parallax>
          <img src={img.src} alt={img.alt} loading="lazy" decoding="async" width="600" height="1299" />
        </div>
      ))}
    </div>
  ) : (
    <div class="media browser" data-reveal data-media>
      <div class="browser-bar mono">
        <div class="win"><span></span><span></span><span></span></div>
        <span class="url">{p.url}</span>
      </div>
      <div class="browser-shot" style={p.width && p.height ? `aspect-ratio: ${p.width} / ${p.height}` : undefined} data-parallax-box>
        <img src={p.image} alt={p.alt} loading="lazy" decoding="async" width={p.width ?? 1600} height={p.height ?? 1000} data-parallax />
      </div>
    </div>
  )}
</article>

<style>
  .result {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 12px;
    padding: 14px 16px;
    border-radius: 12px;
    border: 1px solid var(--border-2);
    background: var(--chip-bg);
    color: var(--strong);
    font-weight: 500;
    line-height: 1.5;
  }
  .result .mono {
    font-size: 11.5px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent-2);
  }
  .project {
    position: relative;
    border-radius: 24px;
    border: 1px solid var(--border);
    background: linear-gradient(var(--card-from), var(--card-to));
    padding: clamp(24px, 3.4vw, 44px);
    display: flex;
    flex-wrap: wrap;
    gap: clamp(32px, 4vw, 56px);
    align-items: center;
    transform-style: preserve-3d;
    will-change: transform;
  }
  .project-glow {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    transition: opacity 400ms;
    background: radial-gradient(420px circle at var(--mx, 50%) var(--my, 50%), rgba(109, 93, 252, 0.16), transparent 60%);
  }
  .project:hover .project-glow {
    opacity: 1;
  }
  .project-copy {
    position: relative;
    flex: 1 1 380px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .kind {
    flex-wrap: wrap;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 12.5px;
    color: var(--dim);
  }
  .kind .n {
    color: var(--accent-2);
  }
  .dash {
    width: 24px;
    height: 1px;
    background: rgba(169, 163, 255, 0.3);
  }
  .project h3 {
    margin: 0;
    font-size: clamp(30px, 3.2vw, 40px);
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--strong);
  }
  .project-desc {
    margin: 0;
    font-size: 16.5px;
    line-height: 1.65;
    color: var(--muted);
  }
  .decisions {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .decisions-label {
    font-size: 11.5px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--dim);
  }
  .decisions ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .decisions li {
    display: flex;
    gap: 14px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--body2);
  }
  .arrow {
    color: var(--accent);
    font-size: 13px;
    padding-top: 2px;
  }
  .links {
    display: flex;
    gap: 20px;
    font-size: 14.5px;
    font-weight: 500;
  }
  .link {
    position: relative;
    display: flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    color: var(--text);
    text-decoration: none;
  }
  .link::before,
  .link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 8px;
    height: 1px;
    background: rgba(169, 163, 255, 0.25);
  }
  .link::after {
    background: var(--accent-2);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 250ms ease;
  }
  .link:hover::after {
    transform: scaleX(1);
  }
  .link :global(svg) {
    transition: transform 250ms ease;
  }
  .link:hover :global(svg) {
    transform: translate(2px, -2px);
  }
  .media {
    position: relative;
    flex: 1.25 1 440px;
    min-width: 0;
    border-radius: 16px;
    border: 1px solid rgba(169, 163, 255, 0.14);
    background-color: var(--frame);
    overflow: hidden;
  }
  .browser-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--line);
    font-size: 11.5px;
    color: var(--faint);
    position: relative;
    z-index: 1;
    background: var(--frame);
  }
  .browser-bar .win {
    display: flex;
    gap: 6px;
  }
  .browser-bar .win span {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: var(--marker-off);
  }
  .url {
    flex: 1;
    text-align: center;
    padding: 4px 10px;
    border-radius: 6px;
    background: rgba(169, 163, 255, 0.06);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .browser-shot {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--frame-inner);
  }
  .browser-shot img {
    width: 100%;
    height: calc(100% + 80px);
    margin-top: -40px;
    object-fit: cover;
    object-position: top;
    transition: scale 400ms ease;
  }
  .project:hover .browser-shot img {
    scale: 1.03;
  }
  .phones {
    aspect-ratio: 16 / 11;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(14px, 2.4vw, 28px);
    padding: 24px;
  }
  .phone {
    width: 30%;
    max-width: 190px;
    aspect-ratio: 9 / 19.5;
    border-radius: clamp(14px, 2vw, 26px);
    border: 1px solid rgba(169, 163, 255, 0.2);
    background: var(--frame-inner);
    overflow: hidden;
    transition: scale 400ms ease;
  }
  .phone img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .phone:not(.mid) {
    margin-top: 28px;
  }
  .phone.mid {
    margin-bottom: 28px;
    box-shadow: 0 30px 60px -30px rgba(109, 93, 252, 0.6);
  }
  .project:hover .phone {
    scale: 1.03;
  }

</style>
